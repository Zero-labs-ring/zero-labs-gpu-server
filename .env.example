# Core auth
ZERO_API_KEY=replace_with_a_strong_api_key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
ENCRYPTION_KEY=replace_with_a_long_random_secret

# Hugging Face
HF_TOKEN=hf_xxx_optional_for_public_models_required_for_private_models

# Supabase (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional public key shown in dashboard/playground copy snippets
NEXT_PUBLIC_ZERO_API_KEY=replace_with_public_gateway_key_if_needed

# Optional runtime settings
CRON_SECRET=replace_with_cron_secret
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
SUPABASE_KEY=optional_alias_for_notebooks_if_used

# Local dev only: set true only when testing localhost without auth headers
ALLOW_INSECURE_LOCAL_DEV_AUTH_BYPASS=false

253.4s	314	
253.4s	315	----- sampling params -----
253.4s	316	
253.4s	317	--samplers SAMPLERS                     samplers that will be used for generation in the order, separated by
253.4s	318	                                        ';'
253.4s	319	                                        (default:
253.4s	320	                                        penalties;dry;top_n_sigma;top_k;typ_p;top_p;min_p;xtc;temperature)
253.4s	321	-s,    --seed SEED                      RNG seed (default: -1, use random seed for -1)
253.4s	322	--sampler-seq, --sampling-seq SEQUENCE
253.4s	323	                                        simplified sequence for samplers that will be used (default:
253.4s	324	                                        edskypmxt)
253.4s	325	--ignore-eos                            ignore end of stream token and continue generating (implies
253.4s	326	                                        --logit-bias EOS-inf)
253.4s	327	--temp, --temperature N                 temperature (default: 0.80)
253.4s	328	--top-k N                               top-k sampling (default: 40, 0 = disabled)
253.4s	329	                                        (env: LLAMA_ARG_TOP_K)
253.4s	330	--top-p N                               top-p sampling (default: 0.95, 1.0 = disabled)
253.4s	331	--min-p N                               min-p sampling (default: 0.05, 0.0 = disabled)
253.4s	332	--top-nsigma, --top-n-sigma N           top-n-sigma sampling (default: -1.00, -1.0 = disabled)
253.4s	333	--xtc-probability N                     xtc probability (default: 0.00, 0.0 = disabled)
253.4s	334	--xtc-threshold N                       xtc threshold (default: 0.10, 1.0 = disabled)
253.4s	335	--typical, --typical-p N                locally typical sampling, parameter p (default: 1.00, 1.0 = disabled)
253.4s	336	--repeat-last-n N                       last n tokens to consider for penalize (default: 64, 0 = disabled)
253.4s	337	--repeat-penalty N                      penalize repeat sequence of tokens (default: 1.00, 1.0 = disabled)
253.4s	338	--presence-penalty N                    repeat alpha presence penalty (default: 0.00, 0.0 = disabled)
253.4s	339	--frequency-penalty N                   repeat alpha frequency penalty (default: 0.00, 0.0 = disabled)
253.4s	340	--dry-multiplier N                      set DRY sampling multiplier (default: 0.00, 0.0 = disabled)
253.4s	341	--dry-base N                            set DRY sampling base value (default: 1.75)
253.4s	342	--dry-allowed-length N                  set allowed length for DRY sampling (default: 2)
253.4s	343	--dry-penalty-last-n N                  set DRY penalty for the last n tokens (default: 64, 0 = disable)
253.4s	344	--dry-sequence-breaker STRING           add sequence breaker for DRY sampling, clearing out default breakers
253.4s	345	                                        ('\n', ':', '"', '*') in the process; use "none" to not use any
253.4s	346	                                        sequence breakers
253.4s	347	--adaptive-target N                     adaptive-p: select tokens near this probability (valid range 0.0 to
253.4s	348	                                        1.0; negative = disabled) (default: -1.00)
253.4s	349	                                        [(more info)](https://github.com/ggml-org/llama.cpp/pull/17927)
253.4s	350	--adaptive-decay N                      adaptive-p: decay rate for target adaptation over time. lower values
253.4s	351	                                        are more reactive, higher values are more stable.
253.4s	352	                                        (valid range 0.0 to 0.99) (default: 0.90)
253.4s	353	--dynatemp-range N                      dynamic temperature range (default: 0.00, 0.0 = disabled)
253.4s	354	--dynatemp-exp N                        dynamic temperature exponent (default: 1.00)
253.4s	355	--mirostat N                            use Mirostat sampling.
253.4s	356	                                        Top K, Nucleus and Locally Typical samplers are ignored if used.
253.4s	357	                                        (default: 0, 0 = disabled, 1 = Mirostat, 2 = Mirostat 2.0)
253.4s	358	--mirostat-lr N                         Mirostat learning rate, parameter eta (default: 0.10)
253.4s	359	--mirostat-ent N                        Mirostat target entropy, parameter tau (default: 5.00)
253.4s	360	-l,    --logit-bias TOKEN_ID(+/-)BIAS   modifies the likelihood of token appearing in the completion,
253.4s	361	                                        i.e. `--logit-bias 15043+1` to increase likelihood of token ' Hello',
253.4s	362	                                        or `--logit-bias 15043-1` to decrease likelihood of token ' Hello'
253.4s	363	--grammar GRAMMAR                       BNF-like grammar to constrain generations (see samples in grammars/
253.4s	364	                                        dir)
253.4s	365	--grammar-file FNAME                    file to read grammar from
253.4s	366	-j,    --json-schema SCHEMA             JSON schema to constrain generations (https://json-schema.org/), e.g.
253.4s	367	                                        `{}` for any JSON object
253.4s	368	                                        For schemas w/ external $refs, use --grammar +
253.4s	369	                                        example/json_schema_to_grammar.py instead
253.4s	370	-jf,   --json-schema-file FILE          File containing a JSON schema to constrain generations
253.4s	371	                                        (https://json-schema.org/), e.g. `{}` for any JSON object
253.4s	372	                                        For schemas w/ external $refs, use --grammar +
253.4s	373	                                        example/json_schema_to_grammar.py instead
253.4s	374	-bs,   --backend-sampling               enable backend sampling (experimental) (default: disabled)
253.4s	375	                                        (env: LLAMA_ARG_BACKEND_SAMPLING)

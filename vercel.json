{
  "framework": "nextjs",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 1800
    }
  },
  "crons": [
    {
      "path": "/api/orchestrator/tick",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/orchestrator/reset-quotas",
      "schedule": "0 0 * * 6"
    }
  ]
}
